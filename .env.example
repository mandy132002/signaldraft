# Copy to .env.local and fill in values:
#   cp .env.example .env.local

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# App URL (local). On Vercel set to https://YOUR_PROJECT.vercel.app
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MongoDB Atlas (or local) ---
# Example Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=signaldraft

# --- LLM (pick one) ---
# Production / Vercel: free Groq key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional force: groq | ollama | auto (default = Groq if key set, else Ollama)
# LLM_PROVIDER=auto

# Local only (ignored on Vercel when GROQ_API_KEY is set)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
